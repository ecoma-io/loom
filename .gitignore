# Claude Code local overrides — the shared settings.json IS tracked.
.claude/settings.local.json

# Git worktrees an agent checks out to work in isolation. They live inside the
# repository, they are a full checkout each, and nothing else ignores them — so
# a single `git add -A` while one exists stages hundreds of megabytes of a
# second copy of this repository into a commit. Measured at 591 MB with two
# open, which is the kind of mistake that is obvious in hindsight and invisible
# at the moment it is made.
.claude/worktrees/

# VitePress build output and its dependency cache.
docs/.vitepress/dist/
docs/.vitepress/cache/

# The staged copy of that build, nested under the path it is served from.
# Derived from the two directories above by `tools/stage-docs.ts`.
.cloudflare/

# Wrangler's local state, written beside the config it reads.
.wrangler/
