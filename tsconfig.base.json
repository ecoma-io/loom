// The compiler options every TypeScript program in this repository shares —
// and, separately, the file three different readers resolve module specifiers
// through.
//
// The split from `tsconfig.json` is not cosmetic. `paths` below is what makes
// `@ecoma-io/loom-button` mean *this repository's source* rather than whatever
// pnpm linked into `node_modules`, and three tools read it: `vue-tsc` for the
// typecheck, ESLint's project service for the type-aware rules, and
// `archkeep check` for the architecture boundary. The third is the reason this
// file has this name: Archkeep's Moon provider reads `tsConfig` from a chain
// of exactly two names — `tsconfig.base.json`, then `tsconfig.json` — and a
// Moon workspace still has no configuration surface to name any other file:
// no `archkeep.json` (the `.moon`/`archkeep.json` pair is refused outright)
// and no plugin-options table in Moon's own config. The two-name chain is what
// closing https://github.com/ecoma-io/archkeep/issues/266 shipped; before it,
// the single hard-coded name was the whole story.
//
// What that gap costs if the paths table is out of reach is measured rather
// than assumed: remove this file and the chain falls through to
// `tsconfig.json`, which extends it but carries no `paths` of its own — every
// `@ecoma-io/loom-*` specifier in the repository then resolves to nothing and
// the run exits 1 reporting each as an undeclared npm package. Loud, at least,
// rather than a green report over an unread tree.
//
// `tsconfig.json` extends this and adds the program's file set;
// `tsconfig.build.json` extends this and adds the declaration emit. Neither
// restates an option.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",

    // The repository's own scripts under `tools/` are run by `node` directly,
    // on Node's type stripping rather than through a bundler — and there,
    // relative imports resolve as plain ESM, which never guesses an extension.
    // `./base.ts` is the filename Node opens; anything shorter fails at run
    // time. Allowed rather than rewritten, because nothing in `src/` imports
    // this way and the published declarations are emitted from `src/` alone.
    "allowImportingTsExtensions": true,

    // The library is bundled by consumers; nothing here emits on its own.
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    // `vite/client` is what types the query-suffixed imports the docs rely on
    // — `?raw` in particular, which is how a documentation page shows a demo's
    // real source instead of a hand-copied snippet that can drift from it.
    "types": ["node", "vite/client"],

    // The Vue TypeScript language-service plugin decorates the host so that
    // `.vue` files resolve to virtual TypeScript content rather than being read
    // from disk as raw text. ESLint's `projectService` shares the same host,
    // so this is also what lets `.ts` files resolve `.vue` module types under
    // the type-aware rules — the fix for the five workarounds removed in the
    // same commit. `vue-tsc` uses its own compilation path and is unaffected.
    "plugins": [{ "name": "@vue/typescript-plugin" }],

    // The documentation site imports Loom by its published name, so a snippet
    // on the site is a snippet a consumer can paste. This is the type-checker's
    // half of that; Vite's half is the matching alias in the VitePress config,
    // and the two have to move together.
    //
    // Internal workspace packages are also mapped here so that TypeScript
    // resolves them to source rather than to a built output. The `@ecoma-io/loom`
    // mapping covers the `import type` from `@ecoma-io/loom` in
    // `packages/labels/src/label-registry.ts` — it is type-only, so there is
    // no runtime cycle despite the apparent one. With the legacy `src/` tree
    // gone, the facade and its `/a11y` subpath resolve to `packages/loom`.
    "paths": {
      "@ecoma-io/loom": ["./packages/loom/src/index.ts"],
      "@ecoma-io/loom/a11y": ["./packages/loom/src/a11y.ts"],
      "@ecoma-io/loom/theme": ["./packages/core/src/theme.ts"],
      "@ecoma-io/loom-core": ["./packages/core/src/index.ts"],
      // Shared test support. `packages/core` already declares this subpath in its
      // `exports` map, which is enough for TypeScript and Vite — but not for the
      // boundary checker, which resolves every specifier through this table and
      // classifies whatever it cannot find here as an external npm package. An
      // internal edge misread as an external one is judged by the wrong rule.
      "@ecoma-io/loom-core/testing": ["./packages/core/src/testing/attach-to-body.ts"],
      "@ecoma-io/loom-labels": ["./packages/labels/src/index.ts"],
      "@ecoma-io/loom-layout-engine": ["./packages/layout-engine/src/index.ts"],
      // Internal component packages. Each one is added as it migrates from src/
      // to packages/<tier>/<name>/.
      "@ecoma-io/loom-hover-card": ["./packages/primitives/hover-card/src/index.ts"],
      "@ecoma-io/loom-progress": ["./packages/primitives/progress/src/index.ts"],
      "@ecoma-io/loom-radial-progress": ["./packages/primitives/radial-progress/src/index.ts"],
      "@ecoma-io/loom-scroll-area": ["./packages/primitives/scroll-area/src/index.ts"],
      "@ecoma-io/loom-separator": ["./packages/primitives/separator/src/index.ts"],
      "@ecoma-io/loom-alert": ["./packages/primitives/alert/src/index.ts"],
      "@ecoma-io/loom-carousel": ["./packages/primitives/carousel/src/index.ts"],
      "@ecoma-io/loom-list": ["./packages/primitives/list/src/index.ts"],
      "@ecoma-io/loom-kbd": ["./packages/primitives/kbd/src/index.ts"],
      "@ecoma-io/loom-timeline": ["./packages/primitives/timeline/src/index.ts"],
      "@ecoma-io/loom-table": ["./packages/primitives/table/src/index.ts"],
      "@ecoma-io/loom-collapse": ["./packages/primitives/collapse/src/index.ts"],
      "@ecoma-io/loom-card": ["./packages/primitives/card/src/index.ts"],
      "@ecoma-io/loom-skeleton": ["./packages/primitives/skeleton/src/index.ts"],
      "@ecoma-io/loom-skip-link": ["./packages/primitives/skip-link/src/index.ts"],
