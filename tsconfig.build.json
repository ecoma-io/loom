// Declaration emit for the published package.
//
// Separate from `tsconfig.json` for two reasons that both come down to scope:
// that file type-checks everything in the repository, including the docs site
// and the tooling, none of which a consumer ever sees; and it sets
// `noEmit`, because `pnpm typecheck` is a verdict, not a build step.
//
// Vite compiles the runtime output and erases types without checking them, so
// `vue-tsc` is run against this config to produce the `.d.ts` files — it is
// the only thing in the build that reads a single-file component's `<script>`
// block as TypeScript.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    // The facade re-exports the package surfaces under `packages/*/src`, so a
    // build that emits declarations for them has to be rooted at the repository
    // rather than at the facade. Each file's declaration still lands under its
    // own package path (packages/*/src/...), which is what a consumer resolves.
    "rootDir": "."
  },
  "include": ["packages/loom/src/**/*"],
  // A demo and a test are documentation and proof respectively. Neither is
  // part of the surface a consumer imports, so neither earns a declaration.
  // The package's `testing/` is the same story a third way: fixtures its test
  // suites import from each other, never from a consumer.
  "exclude": [
    "packages/loom/src/**/*.test.ts",
    "packages/loom/src/**/*Demo.vue",
    "packages/loom/src/testing/**"
  ]
}
